{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-env.d.ts", "./custom-env.d.ts"]
  },
  "include": ["src/**/*.ts", "worker-env.d.ts", "custom-env.d.ts"]
}
