{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "food-tracker-assistant-loader-smoke",
  "main": "src/loader-smoke.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}
