{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "account_id": "317fb84f366ea1ab038ca90000953697",
  "name": "list-to-ladle-notifications",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NOTIFICATIONS_ENABLED": "false",
    "PUSH_ENABLED": "false",
    "PUSH_TEST_ENABLED": "false",
    "PUBLIC_APP_URL": "https://listtoladle.com",
    "APNS_BUNDLE_ID": "com.wodsmith.listtoladle",
    "APNS_ENVIRONMENT": "sandbox"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "food-tracker-db",
      "database_id": "715b9c2b-d8db-43ae-b094-b80d83d81c39",
      "migrations_dir": "../web/src/db/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "list-to-ladle-notification-delivery-sandbox"
      }
    ],
    "consumers": [
      {
        "queue": "list-to-ladle-notification-delivery-sandbox",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "list-to-ladle-notification-dlq-sandbox"
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "env": {
    "production": {
      "vars": {
        "NOTIFICATIONS_ENABLED": "false",
        "PUSH_ENABLED": "false",
        "PUSH_TEST_ENABLED": "false",
        "PUBLIC_APP_URL": "https://listtoladle.com",
        "APNS_BUNDLE_ID": "com.wodsmith.listtoladle",
        "APNS_ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "food-tracker-db",
          "database_id": "715b9c2b-d8db-43ae-b094-b80d83d81c39",
          "migrations_dir": "../web/src/db/migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "DELIVERY_QUEUE",
            "queue": "list-to-ladle-notification-delivery-production"
          }
        ],
        "consumers": [
          {
            "queue": "list-to-ladle-notification-delivery-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 60,
            "dead_letter_queue": "list-to-ladle-notification-dlq-production"
          }
        ]
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    }
  }
}
