## Github Actions Secrets - NOT NECESSARY FOR LOCAL DEV ENVIRONMENT
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

## Stripe Billing
# Use test-mode values locally and configure production values as Worker secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
APP_URL=http://localhost:3000

## Apple App Store subscriptions
# Use identifiers from your own App Store Connect app. Do not copy example IDs
# into production. Product IDs are a comma-separated allowlist.
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_SUBSCRIPTION_PRODUCT_IDS=
APPLE_ENABLE_ONLINE_CHECKS=true
# DER-encoded Apple root certificates, individually base64 encoded.
APPLE_ROOT_CA_1_BASE64=
APPLE_ROOT_CA_2_BASE64=
APPLE_ROOT_CA_3_BASE64=
# App Store Connect In-App Purchase API key credentials (server-side only).
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

## Public legal and support identity (required before production launch)
# Use the actual contracting entity or individual. Do not leave these blank in production.
LEGAL_ENTITY_NAME=
LEGAL_BUSINESS_ADDRESS=
LEGAL_GOVERNING_LAW=
PRIVACY_CONTACT_EMAIL=
SUPPORT_CONTACT_EMAIL=

## Notion API - For recipe scraping script
# Get your API key from: https://www.notion.so/my-integrations
NOTION_API_KEY=
