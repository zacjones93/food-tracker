{
  "name": "food-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --filter=@food-tracker/web",
    "build": "turbo run build --filter=@food-tracker/web",
    "build:prod": "turbo run build:prod --filter=@food-tracker/web",
    "build:analyze": "pnpm --filter @food-tracker/web build:analyze",
    "start": "pnpm --filter @food-tracker/web start",
    "lint": "turbo run lint --filter=@food-tracker/web",
    "typecheck": "turbo run typecheck --filter=@food-tracker/web",
    "test": "turbo run test",
    "opennext:build": "turbo run opennext:build --filter=@food-tracker/web",
    "deploy": "pnpm --filter @food-tracker/web run deploy",
    "preview": "pnpm --filter @food-tracker/web preview",
    "cf-typegen": "pnpm --filter @food-tracker/web cf-typegen",
    "db:studio": "pnpm --filter @food-tracker/web db:studio",
    "db:generate": "pnpm --filter @food-tracker/web db:generate",
    "db:migrate:local": "pnpm --filter @food-tracker/web db:migrate:local",
    "db:migrate:remote": "pnpm --filter @food-tracker/web db:migrate:remote",
    "db:seed:recipes:local": "pnpm --filter @food-tracker/web db:seed:recipes:local",
    "db:seed:recipes:remote": "pnpm --filter @food-tracker/web db:seed:recipes:remote",
    "db:seed:weeks:local": "pnpm --filter @food-tracker/web db:seed:weeks:local",
    "db:seed:weeks:remote": "pnpm --filter @food-tracker/web db:seed:weeks:remote",
    "db:seed:template:local": "pnpm --filter @food-tracker/web db:seed:template:local",
    "db:seed:template:remote": "pnpm --filter @food-tracker/web db:seed:template:remote",
    "db:seed:team:local": "pnpm --filter @food-tracker/web db:seed:team:local",
    "db:seed:team:remote": "pnpm --filter @food-tracker/web db:seed:team:remote",
    "db:seed:ingredients:local": "pnpm --filter @food-tracker/web db:seed:ingredients:local",
    "db:seed:ingredients:remote": "pnpm --filter @food-tracker/web db:seed:ingredients:remote",
    "db:seed:local": "pnpm --filter @food-tracker/web db:seed:local",
    "db:seed:remote": "pnpm --filter @food-tracker/web db:seed:remote",
    "db:clear:local": "pnpm --filter @food-tracker/web db:clear:local",
    "db:clear:remote": "pnpm --filter @food-tracker/web db:clear:remote",
    "db:reseed:local": "pnpm --filter @food-tracker/web db:reseed:local",
    "db:reseed:remote": "pnpm --filter @food-tracker/web db:reseed:remote",
    "d1:cache:clean": "pnpm --filter @food-tracker/web d1:cache:clean",
    "email:dev": "pnpm --filter @food-tracker/web email:dev",
    "list:kv": "pnpm --filter @food-tracker/web list:kv",
    "delete:kv": "pnpm --filter @food-tracker/web delete:kv",
    "scrape:all": "pnpm --filter @food-tracker/web scrape:all",
    "scrape:recipes": "pnpm --filter @food-tracker/web scrape:recipes",
    "scrape:recipes:full": "pnpm --filter @food-tracker/web scrape:recipes:full",
    "scrape:schedule": "pnpm --filter @food-tracker/web scrape:schedule",
    "scrape:relations": "pnpm --filter @food-tracker/web scrape:relations",
    "parse:ingredients": "pnpm --filter @food-tracker/web parse:ingredients",
    "seed:grocery-template": "pnpm --filter @food-tracker/web seed:grocery-template"
  },
  "devDependencies": {
    "turbo": "^2.8.0"
  }
}
